# GEMINI_API_KEY: Required for Gemini AI API calls & Live Search Grounding.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# RAPIDAPI_KEY: RapidAPI key for Indian RTO Vehicle Info & Parivahan API.
RAPIDAPI_KEY=

# OTP_SIGNING_SECRET: Secret used to HMAC-hash OTP codes and sign verification sessions.
# Recommended in production — without it, a default fallback secret is used.
OTP_SIGNING_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key with Maps JavaScript API & Places API enabled.
# Prototyping uses the built-in Maps Demo Key if not provided.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Key ID is public/used by frontend checkout; Key Secret is strictly server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=

# OFFICIAL META WHATSAPP BUSINESS CLOUD API (Direct & Lowest Cost)
# Setup at: https://developers.facebook.com/apps/ -> Add WhatsApp -> API Setup
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=apni_workshop_otp
WHATSAPP_TEMPLATE_LANG=en

# SMS GATEWAY (MSG91 / Fast2SMS / Twilio)
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
SMS_SENDER_ID=

# OBD-II & TELEMATICS API (Auto.dev / CarMD API)
OBD_API_KEY=
VITE_OBD_API_KEY=

# WEBRTC LIVE BAY CCTV STREAMING (Agora / LiveKit / 100ms)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGORA_APP_ID=

