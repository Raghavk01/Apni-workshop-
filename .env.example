# GEMINI_API_KEY: Required for Gemini AI API calls & Live Search Grounding.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# RAPIDAPI_KEY: RapidAPI key for Indian RTO Vehicle Info & Parivahan API.
RAPIDAPI_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key with Maps JavaScript API & Places API enabled.
# Prototyping uses the built-in Maps Demo Key if not provided.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Key ID is public/used by frontend checkout; Key Secret is strictly server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
